@model Asset
@{
    ViewData["Title"] = "Varlık Düzenle";
}

<form asp-action="Edit" method="post" class="form-grid">
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row g-3">
        <div class="col-md-4"><label asp-for="AssetTag" class="form-label"></label><input asp-for="AssetTag" class="form-control" /></div>
        <div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Category" class="form-label"></label><input asp-for="Category" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Brand" class="form-label"></label><input asp-for="Brand" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Model" class="form-label"></label><input asp-for="Model" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="SerialNumber" class="form-label"></label><input asp-for="SerialNumber" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="PurchasedOn" class="form-label"></label><input asp-for="PurchasedOn" type="date" class="form-control" /></div>
        <div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<AssetStatus>()" class="form-select"></select></div>
        <div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="4"></textarea></div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Güncelle</button>
        <a asp-action="Index" class="btn btn-outline-light">İptal</a>
    </div>
</form>
