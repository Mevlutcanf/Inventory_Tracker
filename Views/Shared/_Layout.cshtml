@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Inventory Tracker</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body data-theme="light">

    <nav class="navbar navbar-dark bg-dark border-bottom border-secondary fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand d-flex align-items-center" asp-controller="Home" asp-action="Index">
                <span class="badge bg-primary rounded-pill me-2">IT</span>
                <strong>Inventory Tracker</strong>
            </a>

            <div class="d-flex align-items-center gap-2">
                <ul class="nav me-2">
                    <li class="nav-item"><a class="nav-link text-light @NavClass("Home")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link text-light @NavClass("Assets")" asp-controller="Assets" asp-action="Index">Envanter</a></li>
                    <li class="nav-item"><a class="nav-link text-light @NavClass("Employees")" asp-controller="Employees" asp-action="Index">Çalışanlar</a></li>
                    <li class="nav-item"><a class="nav-link text-light @NavClass("Assignments")" asp-controller="Assignments" asp-action="Index">Zimmetler</a></li>
                </ul>
                <div class="d-flex align-items-center gap-2">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light">@User.Identity.Name</span>
                        <form method="post" asp-controller="Account" asp-action="Logout" class="m-0">
                            <button class="btn btn-sm btn-outline-light ms-2" type="submit">Çıkış</button>
                        </form>
                    }
                    else
                    {
                        <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Giriş</a>
                    }

                    <button id="themeToggle" type="button" class="btn btn-outline-light btn-sm theme-toggle" aria-label="Tema değiştir">
                        <i class="bi bi-moon-stars"></i>
                    </button>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mt-4">
        @RenderBody()
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        (() => {
            const key = 'inventory-theme-v2';
            const body = document.body;
            const button = document.getElementById('themeToggle');

            const applyTheme = (theme) => {
                body.setAttribute('data-theme', theme);
                if (!button) return;
                const icon = button.querySelector('i');
                if (icon) {
                    icon.className = theme === 'dark' ? 'bi bi-sun' : 'bi bi-moon-stars';
                }
            };

            const stored = localStorage.getItem(key);
            const initial = stored === 'dark' ? 'dark' : 'light';
            applyTheme(initial);

            if (button) {
                button.addEventListener('click', () => {
                    const next = body.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                    localStorage.setItem(key, next);
                    applyTheme(next);
                });
            }
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

@functions {
    private string NavClass(string controller)
    {
        var current = ViewContext.RouteData.Values["controller"]?.ToString();
        return string.Equals(current, controller, StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty;
    }
}
